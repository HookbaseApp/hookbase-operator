FROM golang:1.23-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
COPY vendor/ ./vendor/

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -ldflags="-s -w" -o /hookbase-agent ./cmd/agent/

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /
COPY --from=builder /hookbase-agent /hookbase-agent
USER 65532:65532
ENTRYPOINT ["/hookbase-agent"]
